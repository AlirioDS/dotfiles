# Guardrails: never commit credentials or history, even by accident
hosts.yml
ngrok.yml
*.bak
*.pem
*.key
.env*
!.env.example
*_history
*history*
*.log
# Machine-local git identity (real name/email) — only the .example is tracked
.gitconfig.local
gitconfig.local
# Credential stores and keys that must never be copied in, whatever the path
.ssh/
id_*
*.ppk
.aws/
.docker/
.railway/
.claude.json
auth.json
# Herdr runtime state: only config.toml is tracked
config/herdr/*
!config/herdr/config.toml
*.sock
session.json
session-snapshots/
__pycache__/
# Audit reports and run artifacts stay local: reports quote secret patterns and internal hook details
tools/herdr-tmux-audit/codex-audit-*.md
tools/herdr-tmux-audit/run/
tools/herdr-tmux-audit/.herdr-audit-root
*.bin
# Written per machine by `herdr integration install claude`; save.sh also strips its settings entry
claude/hooks/herdr-agent-state.sh
