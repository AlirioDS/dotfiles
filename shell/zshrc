# ssh-agent
[ -z "$SSH_AUTH_SOCK" ] && eval "$(ssh-agent -s)" >/dev/null
ssh-add -l >/dev/null 2>&1 || ssh-add ~/.ssh/id_github >/dev/null 2>&1
# /ssh-agent

# === GO ===
export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"
# === /GO ===

# asdf (release binary in ~/.asdf/bin; shims for managed tools)
export ASDF_DATA_DIR="$HOME/.asdf"
export PATH="$ASDF_DATA_DIR/bin:$ASDF_DATA_DIR/shims:$PATH"
export PATH="$PATH:${GOBIN:-$(go env GOPATH 2>/dev/null)/bin}"

# --- Auto-start tmux: nueva sesión numérica por pestaña (sin awk) ---
if [[ $- == *i* ]] && [[ -z "$TMUX" ]] && [[ -z "$NO_TMUX" ]] && [[ "${HERDR_ENV:-}" != 1 ]] && command -v tmux >/dev/null 2>&1; then
  # Lista de sesiones numéricas existentes (puede estar vacía)
  sessions="$(tmux ls -F '#{session_name}' 2>/dev/null | grep -E '^[0-9]+$' | sort -n || true)"

  i=0
  # Busca el menor número libre
  while echo "$sessions" | grep -qx "$i"; do
    i=$((i+1))
  done

  # Crea y entra en esa sesión (sin -d y sin detach de otras)
  tmux new -s "$i"
fi
# --- /Auto-start tmux ---


# Load Angular CLI autocompletion.
if command -v ng >/dev/null 2>&1; then
  source <(ng completion script)
fi
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:/snap/bin"
