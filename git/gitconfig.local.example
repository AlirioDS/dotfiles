# Template for machine-local git identity.
# Copy to ~/.gitconfig.local and fill in your details:
#     cp git/gitconfig.local.example ~/.gitconfig.local
# The committed gitconfig pulls this in via [include]. It is git-ignored, so your
# identity never lands in a tracked file (commits you make still record their author).
[user]
	email = you@example.com
	name = Your Name
